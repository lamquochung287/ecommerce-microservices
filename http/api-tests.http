# =========================================================================
# Ecommerce Microservices - API Test Requests
# Used with VS Code "REST Client" extension
# =========================================================================

@baseUrl = http://localhost:3000
@apiKey = adfsdfbzvb_fdaf342

###
# @name HelloGateway
# 1. Gateway Health Check (calls User TCP service to get Hello User)
# NOTE: Check response headers for "x-request-id" (Correlation ID)
GET {{baseUrl}}/
Accept: application/json
x-api-key: {{apiKey}}


# =========================================================================
# Idempotency & Correlation ID Tracing Tests
# =========================================================================

###
# @name RegisterUserWithIdempotency
# 2. Register user WITH an Idempotency Key
# FIRST CALL: Should process normally and save response to Redis (TTL 24h).
# SECOND CALL (same key): Should instantly return the identical cached response.
# CONCURRENT CALLS: Running this concurrently in parallel will return a 409 Conflict.
POST {{baseUrl}}/user/register
Content-Type: application/json
x-api-key: {{apiKey}}
x-idempotency-key: idempotency-test-key-999

{
  "email": "idempotent.user@example.com",
  "password": "securePassword123",
  "fullName": "Idempotent User"
}


###
# @name LoginWithIdempotency
# 3. Login user WITH an Idempotency Key
# FIRST CALL: Processes login, generates tokens, saves result to Redis.
# SECOND CALL (same key): Instantly returns the cached tokens from Redis without querying DB.
POST {{baseUrl}}/user/login
Content-Type: application/json
x-api-key: {{apiKey}}
x-idempotency-key: login-idempotency-key-888

{
  "email": "idempotent.user@example.com",
  "password": "securePassword123"
}


# =========================================================================
# User Service (Gateway Routing)
# =========================================================================

###
# @name RegisterUser
# 4. Register new user (WITHOUT idempotency key)
POST {{baseUrl}}/user/register
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "email": "testuser@example.com",
  "password": "securePassword123",
  "fullName": "Test User"
}


###
# @name LoginUser
# 5. Login user (WITHOUT idempotency key)
POST {{baseUrl}}/user/login
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "email": "testuser@example.com",
  "password": "securePassword123"
}

### Capture JWT Token from Login Response
@accessToken = {{LoginUser.response.body.$.data.accessToken}}
@refreshToken = {{LoginUser.response.body.$.data.refreshToken}}
@sessionId = {{LoginUser.response.body.$.data.sessionId}}
@userId = {{LoginUser.response.body.$.data.user.id}}


###
# @name GetUserProfile
# 6. Get User Profile (using param userId)
# NOTE: Check response headers for automatic "x-request-id" generation.
GET {{baseUrl}}/user/profile/{{userId}}
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Accept: application/json


###
# @name GetAllUsers
# 7. Get All Users List
GET {{baseUrl}}/user
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Accept: application/json


###
# @name FindIdByUserId
# 8. Find internal database ID by uuid userId
GET {{baseUrl}}/user/id/{{userId}}
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Accept: application/json


###
# @name LogoutUser
# 9. Logout (removes refresh token from Redis cache)
POST {{baseUrl}}/user/logout
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userId": "{{userId}}",
  "sessionId": "{{sessionId}}"
}


# =========================================================================
# Product Service
# =========================================================================

###
# @name GetAllProducts
# 10. Get all products
GET {{baseUrl}}/products
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###
# @name CreateProduct
# 11. Create a new product
# NOTE: categoryId is REQUIRED. You must insert a Category UUID that exists in your database.
# Otherwise, it will throw a 404 Category Not Found error.
POST {{baseUrl}}/products
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Test Product",
  "slug": "test-product",
  "description": "This is a product created via API test",
  "price": 199.99,
  "stock": 50,
  "categoryId": "00000000-0000-0000-0000-000000000000"
}

### Capture Product ID
@productId = {{CreateProduct.response.body.data.id}}

###
# @name GetProductById
# 12. Get product by ID
GET {{baseUrl}}/products/{{productId}}
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###
# @name UpdateProduct
# 13. Update a product
PUT {{baseUrl}}/products/{{productId}}
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Test Product Updated",
  "price": 150.00
}

###
# @name DeleteProduct
# 14. Delete a product
DELETE {{baseUrl}}/products/{{productId}}
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Accept: application/json


# =========================================================================
# Order Service
# =========================================================================

###
# @name GetHelloOrdersViaGateway
# 15. Check Orders Service via Gateway (routing to Orders service)
GET {{baseUrl}}/orders
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Accept: application/json

# =========================================================================
# Checkout v2 (chọn món, idempotency bắt buộc, thanh toán simulator)
# =========================================================================

###
# @name AddCartItem
# Thêm món vào giỏ (số lượng do giỏ giữ, checkout không gửi quantity/giá/userId)
POST {{baseUrl}}/cart/items
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 1
}

###
# @name Checkout
# Bắt buộc x-idempotency-key (thiếu -> 400). Trả {orderId, status, payment_url, expiresAt}
POST {{baseUrl}}/cart/checkout
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
x-idempotency-key: checkout-{{$guid}}
Content-Type: application/json

{
  "items": [{ "productId": "{{productId}}" }],
  "shippingAddress": {
    "recipientName": "Nguyen Van A",
    "recipientPhone": "0900000000",
    "addressLine1": "1 Nguyen Hue",
    "city": "Ho Chi Minh",
    "country": "VN"
  },
  "voucherCode": "SALE10"
}

###
@orderId = {{Checkout.response.body.$.data.orderId}}

###
# @name GetPaymentLink
# Chốt kiểm tra còn giữ hàng; trả {paymentUrl, expiresAt}
GET {{baseUrl}}/orders/{{orderId}}/pay
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}

###
# @name SimulatorPage
# Trình duyệt không gửi x-api-key; trang tắt (404) khi NODE_ENV=production
@intentId = replace-with-intent-id-from-paymentUrl
GET {{baseUrl}}/simulator/pay/{{intentId}}

###
# @name SimulatorPaySuccess
POST {{baseUrl}}/simulator/pay/{{intentId}}/success

###
# @name SimulatorPayFail
POST {{baseUrl}}/simulator/pay/{{intentId}}/fail

###
# @name CancelOrder
POST {{baseUrl}}/orders/{{orderId}}/cancel
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}

###
# @name RequestReturn
# Chỉ đơn DELIVERED trong cửa sổ đổi trả
POST {{baseUrl}}/orders/{{orderId}}/return
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Sản phẩm lỗi"
}

###
# @name ShipmentDeliver
# Admin/mô phỏng: đánh dấu đã giao (cần quyền ORDER/UPDATE)
POST {{baseUrl}}/shipments/{{orderId}}/deliver
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}

###
# @name GetShipment
GET {{baseUrl}}/shipments/{{orderId}}
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}

###
# @name AdjustStock
# Tồn kho do Inventory quản lý
POST {{baseUrl}}/products/{{productId}}/stock-adjustments
x-api-key: {{apiKey}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "delta": 10
}
