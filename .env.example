# Sao chép thành .env rồi chạy: npm run docker:up && npm run start:all
# Giá trị mặc định khớp docker-compose.yml (chạy local). KHÔNG dùng các secret dưới đây ở production.
#
# [BẮT BUỘC]  thiếu một biến -> validateEnv làm mọi service không khởi động.
# [TUỲ CHỌN]  bỏ trống/comment thì dùng mặc định trong code (ghi ở cuối mỗi dòng).

# ---------------------------------------------------------------------------
# PostgreSQL [BẮT BUỘC] (một DB chung cho mọi service)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=password
DB_NAME=ecommerce
# Kích thước pool kết nối mỗi service [TUỲ CHỌN]
# DB_POOL_MAX=50
# DB_POOL_MIN=5

# ---------------------------------------------------------------------------
# Redis [BẮT BUỘC: HOST, PORT] (session, cart, throttle, idempotency)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis trong docker-compose không đặt mật khẩu
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# JWT [BẮT BUỘC] (đổi secret thành chuỗi ngẫu nhiên dài)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=7d

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Header x-api-key mà client phải gửi [BẮT BUỘC]
API_KEY=change-me-api-key
# [TUỲ CHỌN] cổng HTTP (3000), danh sách origin CORS cách nhau bởi dấu phẩy
# GATEWAY_PORT=3000
# CORS_ORIGINS=http://localhost:3000
# [TUỲ CHỌN] giới hạn request/phút/IP: mặc định chung 100, login/register 5
# THROTTLE_LIMIT_DEFAULT=100
# THROTTLE_LOGIN_LIMIT=5
# [TUỲ CHỌN] cổng metrics Prometheus của gateway (9464); đặt riêng khi chạy nhiều instance
# GATEWAY_METRICS_PORT=9464
# [TUỲ CHỌN] URL public dùng dựng payment_url (http://localhost:3000)
# PUBLIC_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Kafka [BẮT BUỘC: KAFKA_BROKERS] (broker local trong docker-compose, listener host :9092)
# ---------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
# [TUỲ CHỌN]
# KAFKA_TOPIC_PARTITIONS=3
# KAFKA_CONSUMER_MAX_ATTEMPTS=3
# KAFKA_CONSUMER_RETRY_BACKOFF_MS=200
# OUTBOX_RELAY_INTERVAL_MS=1000
# OUTBOX_MAX_RETRY=10

# ---------------------------------------------------------------------------
# Webhook HMAC [BẮT BUỘC] (không có giá trị mặc định)
# ---------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
SHIPPING_WEBHOOK_SECRET=change-me-shipping-webhook-secret

# ---------------------------------------------------------------------------
# Simulator thanh toán / giao hàng [TUỲ CHỌN]
# NODE_ENV=production sẽ tắt simulator (404)
# ---------------------------------------------------------------------------
# NODE_ENV=development
# manual | auto-success | auto-fail (mặc định manual)
# PAYMENT_SIM_MODE=manual
# PAYMENT_SIM_DELAY_MS=
# success | fail (mặc định success); >0 tự giao hàng sau ngần ms (mặc định 0 = giao tay)
# SHIPPING_SIM_MODE=success
# SHIPPING_SIM_DELIVER_DELAY_MS=0

# ---------------------------------------------------------------------------
# Đơn hàng / giỏ hàng / tồn kho [TUỲ CHỌN]
# ---------------------------------------------------------------------------
# Thuế và phí ship cố định (mặc định 0.1 và 30000)
# ORDER_TAX_RATE=0.1
# ORDER_SHIPPING_FEE_FLAT=30000
# Giữ hàng + hạn thanh toán, giây (900)
# ORDER_PAYMENT_TTL_SECONDS=900
# Cửa sổ đổi trả, ngày (7)
# ORDER_RETURN_WINDOW_DAYS=7
# Số đơn mỗi lượt quét của scheduler (100)
# ORDER_LIFECYCLE_BATCH_SIZE=100
# TTL giỏ hàng, giây (2592000 = 30 ngày)
# CART_TTL_SECONDS=2592000
# Reservation quá hạn thêm ngần giây mới bị dọn (60)
# INVENTORY_EXPIRY_GRACE_SECONDS=60

# ---------------------------------------------------------------------------
# bcrypt ở User service [TUỲ CHỌN]
# Hàng đợi đầy hoặc chờ quá hạn -> 429
# ---------------------------------------------------------------------------
# BCRYPT_MAX_CONCURRENCY=4
# BCRYPT_QUEUE_LIMIT=300
# BCRYPT_QUEUE_WAIT_MS=8000

# ---------------------------------------------------------------------------
# MinIO (media) [TUỲ CHỌN] (mặc định khớp docker-compose)
# ---------------------------------------------------------------------------
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
