# Gộp 8 app NestJS vào 1 container để mô phỏng 1 VPS: các process cùng chia sẻ CPU/RAM
# theo giới hạn của container (cpus / mem_limit trong docker-compose.loadtest.yml).
FROM node:22-slim AS compile
WORKDIR /usr/src/app
COPY package*.json ./
RUN npm ci
COPY . .
RUN for app in user product orders payment notification review promotion gateway; do npx nest build $app || exit 1; done

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /usr/src/app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=compile /usr/src/app/dist ./dist
COPY loadtest/start-apps.sh ./start-apps.sh
RUN sed -i 's/\r$//' ./start-apps.sh && chmod +x ./start-apps.sh
CMD ["./start-apps.sh"]
